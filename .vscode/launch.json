{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug basic_func.exe",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Basic_Functions/BasicFunctions.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Basic_Functions",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build basic_func.exe"
        }
    ]
}
